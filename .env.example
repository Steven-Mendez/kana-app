# Copy to .env.local and fill in your Supabase project's public values.
# Supply both variables in the build environment for cloud builds and web exports.
# Vercel: use Config variables for Production and Preview, then redeploy.
# Keep actual project values out of Git; commit only this placeholder template.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_your-key

# Optional for web OAuth; must match the current site's origin exactly.
# Omit for previews that use their own origin and explicitly allow those callbacks in Auth.
# EXPO_PUBLIC_AUTH_ORIGIN=https://your-domain.example

# Google + guest access works without SMTP. Set Google false to hide it.
EXPO_PUBLIC_ENABLE_GOOGLE_AUTH=true
# Enable only after configuring and verifying each provider.
EXPO_PUBLIC_ENABLE_APPLE_AUTH=false
EXPO_PUBLIC_ENABLE_EMAIL_AUTH=false
