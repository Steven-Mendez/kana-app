{
  "name": "kana-app",
  "version": "1.0.0",
  "packageManager": "pnpm@11.8.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.118.0",
    "expo": "~58.0.17",
    "expo-apple-authentication": "~58.0.2",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "tailwindcss": "4.3.3",
    "ts-fsrs": "5.4.2",
    "uniwind": "1.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.6",
    "husky": "9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "react-doctor": "0.9.18",
    "supabase": "2.121.0",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "lint": "expo lint --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "react-doctor . --yes --no-telemetry --no-supply-chain",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm doctor",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,jsonc,md,mdx,yaml,yml,css,html}": "prettier --write"
  },
  "reactDoctor": {
    "ignore": {
      "files": [
        ".agents/**",
        ".opencode/**",
        "ios/**",
        "android/**",
        "dist/**"
      ]
    }
  },
  "private": true
}
