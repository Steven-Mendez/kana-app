{
  "name": "kana-app",
  "version": "1.0.0",
  "packageManager": "pnpm@11.8.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "expo": "~58.0.16",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "react-doctor": "0.9.18",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "lint": "expo lint --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "react-doctor . --yes --no-telemetry --no-supply-chain",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm doctor",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,jsonc,md,mdx,yaml,yml,css,html}": "prettier --write"
  },
  "reactDoctor": {
    "ignore": {
      "files": [
        ".agents/**",
        ".opencode/**",
        "ios/**",
        "android/**",
        "dist/**"
      ]
    }
  },
  "private": true
}
